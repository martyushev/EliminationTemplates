<Group hide-output="false" labelreference="L4588" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">### compute coefficient matrix of initial polynomial system
interface(warnlevel=1):
cat(C_, prob) := proc({symbolic:=1})
    _name, _size := [`d`, `x1`, `x2`], [[6,7], [2,2]$2]:
    if symbolic=0 then
        _A := [seq(rndMat(_size[i][]), i=1..nops(_name))]:
    else
        _A := [seq(Matrix(_size[i][], (x,y)-&gt;_name[i](x+(y-1)*_size[i][1])), i=1..nops(_name))]:
    end if:
    
    ################## place your code for constructing polynomials here
    vv := &lt;x*z, y*z, z^2, x, y, z, 1&gt;:
    f11 := add(_A[1][1,i]*vv[i], i=1..7):
    f21 := add(_A[1][2,i]*vv[i], i=1..7):
    f31 := add(_A[1][3,i]*vv[i], i=1..7):
    f12 := add(_A[1][4,i]*vv[i], i=1..7):
    f22 := add(_A[1][5,i]*vv[i], i=1..7):
    f32 := add(_A[1][6,i]*vv[i], i=1..7):
    F := &lt;f11,f12,x; f21,f22,y; f31,f32,1&gt;:
    xx1 := &lt;_A[2], &lt;1+(_A[2][1,1]^2+_A[2][2,1]^2)*z|1+(_A[2][1,2]^2+_A[2][2,2]^2)*z&gt;&gt;:
    xx2 := &lt;_A[3], &lt;1+(_A[3][1,1]^2+_A[3][2,1]^2)*z|1+(_A[3][1,2]^2+_A[3][2,2]^2)*z&gt;&gt;:
    epi := xx2^+.F.xx1:
    eqs := [epi[1,1], epi[2,2], LinearAlgebra[Determinant](F)]:
    ##################

    _F := map(expand, eqs):
    if symbolic=0 then return _F: end if:
    _vars := indets(_F) minus indets(_A):
    _C0, _V0 := poly2matrix(_F, _vars):
    _V := srt(_V0, tdeg(_vars[])):
    [permuteColumns(_C0, _V0, _V)], _V, _name, _size:
end proc:</Text-field>
</Input>
</Group><Presentation-Block>
