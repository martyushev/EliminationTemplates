<Group labelreference="L4613" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">### compute coefficient matrix of initial polynomial system
interface(warnlevel=1):
cat(C_, prob) := proc({symbolic:=1})
    _name, _size := [`X`, `x0`, `y0`], [[3,4], [4,1], [3,1]]:
    if symbolic=0 then
        _A := [seq(rndMat(_size[i][]), i=1..nops(_name))]:
    else
        _A := [seq(Matrix(_size[i][], (x,y)-&gt;_name[i](x+(y-1)*_size[i][1])), i=1..nops(_name))]:
    end if:
    
    ################## place your code for constructing polynomials here
    xx, xx0, yy0 := _A[1], convert(_A[2], Vector), convert(_A[3], Vector):
    R := &lt;1+x^2-y^2,2*x*y,2*y; 2*x*y,y^2-x^2+1,-2*x; -2*y,2*x,1-x^2-y^2&gt;:
    R1, R2, R3 := R[1,..], R[2,..], R[3,..]:
    iddes := &lt;1,2,3; 1,3,2; 2,4,3; 3,4,2&gt;:
    F := Matrix(4,3):
    for l from 1 to 4 do
        i, j, k := iddes[l,1], iddes[l,2], iddes[l,3]:
        F[l,1] := (yy0[i]-yy0[k])*R1.(xx[..,j]-xx[..,i])-(xx0[i]-xx0[j])*R2.(xx[..,k]-xx[..,i]):
        F[l,2] := -(yy0[i]-yy0[k])*R2.(xx[..,j]-xx[..,i])-(xx0[i]-xx0[j])*R1.(xx[..,k]-xx[..,i]):
        F[l,3] := -xx0[j]*(yy0[i]-yy0[k])*R3.(xx[..,j]-xx[..,i])+yy0[k]*(xx0[i]-xx0[j])*R3.(xx[..,k]-xx[..,i]):
    end do:
    eqs := [seq(LinearAlgebra[Determinant](LinearAlgebra[DeleteRow](F, i)), i=1..4)]:
    ##################

    _F := map(expand, eqs):
    if symbolic=0 then return _F: end if:
    _vars := indets(_F) minus indets(_A):
    _C0, _V0 := poly2matrix(_F, _vars):
    _V := srt(_V0, tdeg(_vars[])):
    [permuteColumns(_C0, _V0, _V)], _V, _name, _size:
end proc:</Text-field>
</Input>
</Group><Presentation-Block>
